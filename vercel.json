{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/webinar", "destination": "/webinar.html" },
    { "source": "/room", "destination": "/room.html" },
    { "source": "/confirmation", "destination": "/confirmation.html" },
    { "source": "/thank-you", "destination": "/confirmation.html" },
    { "source": "/about-us", "destination": "/about-us.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/shipping-and-return-policy", "destination": "/shipping-policy.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/refund-and-cancellation-policy", "destination": "/refund-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/terms.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/api/test-whatsapp", "destination": "/api/whatsapp-send?test=true" }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "*/10 * * * *"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/webinar", "destination": "/", "permanent": true },
    { "source": "/webinar.html", "destination": "/", "permanent": true },
    { "source": "/room", "destination": "/", "permanent": true },
    { "source": "/room.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/confirmation", "destination": "/confirmation.html" },
    { "source": "/thank-you", "destination": "/confirmation.html" },
    { "source": "/pay-upi", "destination": "/pay-upi.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/pay", "destination": "/payment.html" },
    { "source": "/about-us", "destination": "/about-us.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/shipping-and-return-policy", "destination": "/shipping-and-return-policy.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/refund-and-cancellation-policy", "destination": "/refund-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/terms-and-conditions.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/api/test-whatsapp", "destination": "/api/whatsapp-send?test=true" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|svg|webp|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}

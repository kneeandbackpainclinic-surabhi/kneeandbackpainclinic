{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/webinar", "destination": "/webinar.html" },
    { "source": "/room", "destination": "/room.html" },
    { "source": "/confirmation", "destination": "/confirmation.html" },
    { "source": "/thank-you", "destination": "/confirmation.html" },
    { "source": "/api/test-whatsapp", "destination": "/api/whatsapp-send?test=true" }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "*/10 * * * *"
    }
  ]
}

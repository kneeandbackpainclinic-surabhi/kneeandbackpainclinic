# ==============================================================================
# CHARAK HEALTH SOLUTIONS - DR. SURABHI VAIDYA CLINIC
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local testing: cp .env.example .env.local
# 2. In Vercel Dashboard, go to Project Settings -> Environment Variables and paste these keys.
# 3. NEVER commit your real .env or .env.local file to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Production base URL of the website
NEXT_PUBLIC_APP_URL=https://dr-surabhi-knee-and-back-pain-relie-azure.vercel.app

# Secret token used by admin panel to securely call backend serverless endpoints
ADMIN_SECRET_KEY=surabhi2026_clinic_secure_passphrase_here

# Notification email for clinic staff when a new intake lead arrives
CLINIC_ADMIN_EMAIL=surabhi.ayurveda@gmail.com
CLINIC_DESK_PHONE=+918108500200


# ------------------------------------------------------------------------------
# 2. AI VOICE CALLING PROVIDERS (PICK ONE OR MORE)
# ------------------------------------------------------------------------------
# OPTION A: Vapi.ai (Recommended for conversational Hindi & English AI Voice Agents)
# Get from: https://dashboard.vapi.ai
VAPI_API_KEY=vapi_sec_live_your_vapi_private_key_here
VAPI_ASSISTANT_ID=asst_your_dr_surabhi_voice_agent_id
VAPI_PHONE_NUMBER_ID=phone_your_assigned_vapi_phone_id

# OPTION B: Bland.ai (Fast phone calling agent)
# Get from: https://app.bland.ai
BLAND_API_KEY=org_your_bland_secret_key_here
BLAND_PATHWAY_ID=pathway_your_bland_script_pathway_id

# OPTION C: Retell AI (Ultra-low latency voice agent)
# Get from: https://beta.retellai.com
RETELL_API_KEY=key_your_retell_private_key_here
RETELL_AGENT_ID=agent_your_retell_agent_id_here


# ------------------------------------------------------------------------------
# 3. INDIAN TELEPHONY & SMS PROVIDERS (DND-COMPLIANT CALLING & SMS)
# ------------------------------------------------------------------------------
# OPTION A: Exotel (Leading Indian Telecom & SMS Gateway)
# Get from: https://my.exotel.com
EXOTEL_SID=your_exotel_subdomain
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=+918047123456

# OPTION B: Twilio (Global Voice & SMS)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890


# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS AUTOMATION (OFFICIAL META OR INDIAN BSP)
# ------------------------------------------------------------------------------
# OPTION A: Official Meta WhatsApp Business Cloud API
# Get from: https://developers.facebook.com -> WhatsApp -> API Setup
META_WHATSAPP_ACCESS_TOKEN=EAAG...your_permanent_system_user_token
META_WHATSAPP_PHONE_NUMBER_ID=109876543210987
META_WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=surabhi_webhook_verify_token_2026

# OPTION B: AiSensy / Interakt / Wati (Indian WhatsApp Marketing APIs)
# Get from your AiSensy or Interakt dashboard
AISENSY_API_KEY=your_aisensy_campaign_api_key_here
INTERAKT_API_KEY=your_interakt_api_key_here


# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL API (ZOOM LINKS, CONFIRMATIONS & DIET PDF)
# ------------------------------------------------------------------------------
# OPTION A: Resend (Recommended, fast & modern email API)
# Get from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL="Dr. Surabhi Vaidya Clinic <consultations@dr-surabhi.com>"

# OPTION B: SendGrid
# Get from: https://app.sendgrid.com
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here


# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (RS 201 MASTERCLASS & RS 1,000 / RS 4,000 SESSIONS)
# ------------------------------------------------------------------------------
# OPTION A: Razorpay (India Standard)
# Get from: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_payment_verification

# OPTION B: Cashfree
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key


# ------------------------------------------------------------------------------
# 7. WEBINAR PLATFORM INTEGRATION (ZOOM / GOOGLE MEET)
# ------------------------------------------------------------------------------
# Zoom Server-to-Server OAuth (For automatic attendee registration)
# Get from: https://marketplace.zoom.us/develop/create -> Server-to-Server OAuth
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBINAR_ID=8108500200
ZOOM_WEBINAR_PASSWORD=surabhi_charak


# ------------------------------------------------------------------------------
# 8. DATABASE & CRM STORAGE (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_secret_key


# ------------------------------------------------------------------------------
# 9. EXTERNAL WEBHOOK INTEGRATION (ZAPIER / MAKE.COM / N8N)
# ------------------------------------------------------------------------------
# If you use Make.com or Zapier to route leads into Google Sheets or CRM
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_unique_webhook_id
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_unique_webhook_id
